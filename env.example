# 외부 MySQL 접속 정보 — 이 값을 채운 .env 파일을 만들어 사용한다.
# .env는 저장소에 커밋하지 않는다(.gitignore 처리), 이 파일(.env.example)만 커밋한다.
#
# (2026-09-27 변경) MySQL은 Docker를 돌리는 VM과 같은 물리 PC가 아니라,
# 같은 LAN(공유기) 안의 "DB 담당자" PC에서 구축한다. VM 네트워크
# 어댑터를 VirtualBox에서 Bridged로 바꿔야 이 PC에 닿는다 — Host-only
# 어댑터(예: 192.168.56.x)는 VM과 그 VM을 돌리는 물리 PC 사이에서만
# 통하고, 공유기 너머 다른 PC와는 통신할 수 없다. 자세한 절차는
# mysql/README_MySQL_구축_가이드.md B-1절.
#
# DB_HOST: 담당자 PC의 LAN IP(예: 192.168.0.42, 담당자에게 직접
#          전달받음). localhost/127.0.0.1이나 VirtualBox Host-only IP는
#          쓰지 않는다 — 컨테이너/VM 자기 자신을 가리켜버린다.
DB_HOST=192.168.0.42
DB_PORT=3306
DB_NAME=posture_app
DB_USER=posture_app
DB_PASSWORD=changeme

# Redis / Kafka는 같은 app-network 안의 컨테이너이므로 서비스명을 그대로 쓴다.
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:19092

# (2026-10-02 아키텍처 v4 전환, D-13) posture-cep(Python) 서비스는
# 제거됐고, 그 상태머신·세션 만료 로직은 api-server 안으로 이식됐다.
# api-server가 이미 DB_*(posture_app) 값으로 datasource를 구성하므로
# 별도 DB 접속 정보가 필요 없다 — sessions/collapse_events 기록도 같은
# 커넥션 풀을 쓴다.
#
# 아래 값은 전부 기본값과 동일하므로 바꿀 필요가 없을 때는 생략해도
# 된다. 팀 회의에서 파라미터를 다른 값으로 확정하면 여기서 덮어쓴다.
KAFKA_TOPIC_POSTURE_INFERENCE=posture.inference
CEP_PERSIST_SECONDS=3
CEP_RECOVERY_SECONDS=3
CEP_REALERT_SECONDS=60
CEP_SESSION_TIMEOUT_SECONDS=300
CEP_SESSION_EXPIRY_INTERVAL_SECONDS=60