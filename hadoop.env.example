# ============================================================
# hadoop.env — hdfs-namenode / hdfs-datanode 컨테이너 공통 설정
# docker-compose.yml의 env_file로 두 서비스가 함께 참조한다.
# ============================================================

CORE_CONF_fs_defaultFS=hdfs://hdfs-namenode:9000

# 단일 노드 테스트 환경이므로 복제(replication)는 1로 고정한다.
# (실습 PC 멀티노드로 옮길 때는 노드 수에 맞춰 2~3으로 올리는 것을 검토)
HDFS_CONF_dfs_replication=1

# NameNode 웹 UI에서 외부 접속 허용
CORE_CONF_hadoop_http_staticuser_user=root

# 컨테이너 재기동 시 권한 문제 방지
HDFS_CONF_dfs_permissions_enabled=false
