<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.posture</groupId>
  <artifactId>api-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>api-server</name>
  <description>
    자세 분석 시스템 API 서버 (Spring Boot).
    현재 단계 목표: 실제 인증/비즈니스 로직 이전에, 외부 MySQL·Kafka·Redis
    연결 상태를 /actuator/health 로 확인 가능한 헬스체크 수준의 골격.
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- 웹 + 헬스체크 엔드포인트(/actuator/health) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 수집 API 요청 검증 (@Valid) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 외부 MySQL 연결 확인용 (DataSourceHealthIndicator 자동 등록) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Redis 연결 확인용 (RedisHealthIndicator 자동 등록) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!--
      Kafka 연결/헬스체크 + KafkaTemplate 자동 등록용.
      Spring Boot 4.0부터 KafkaAutoConfiguration(=KafkaTemplate,
      KafkaAdmin, KafkaHealthIndicator 등을 만들어주는 자동설정)이
      거대한 spring-boot-autoconfigure 묶음에서 spring-boot-kafka라는
      별도 모듈로 분리됐다. 순수 라이브러리인
      org.springframework.kafka:spring-kafka만 넣으면 이 자동설정이
      전혀 동작하지 않아 KafkaTemplate 빈을 찾을 수 없다는 에러가 난다.
      spring-boot-starter-kafka를 쓰면 spring-kafka 라이브러리와
      spring-boot-kafka 자동설정 모듈이 함께 들어온다.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Spring Boot 4.0부터 @WebMvcTest 등 MVC 슬라이스 테스트 지원이
      spring-boot-starter-test의 범용 autoconfigure 묶음에서 빠지고
      메인 스타터(spring-boot-starter-web)에 대응하는 전용 테스트
      스타터로 분리되었다. spring-boot-starter-test만으로는
      org.springframework.boot.webmvc.test.autoconfigure 패키지가
      클래스패스에 없어 컴파일 에러가 난다.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>api-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
